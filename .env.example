DATABASE_URL=
REDIS_URL=redis://localhost:6379
MESSAGE_MEMORY_TTL_SECONDS=21600

# WhatsApp (YCloud): un despliegue = un tenant, así que las credenciales viven en el entorno
API_KEY_YCLOUD=
YCLOUD_WEBHOOK_SECRET=

# Número de WhatsApp que atiende este despliegue (lo muestra el panel en "Números")
WHATSAPP_PHONE_NUMBER=
WHATSAPP_NUMBER_LABEL=
WHATSAPP_WABA_ID=

# Rag-API (conocimiento)
RAG_API_URL=http://localhost:3100
# El conocimiento usa la colección por defecto `qwen` del tenant (Rag-API la crea sola); el tenant va dentro del token de servicio
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.35

# Orígenes del panel (CORS), separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# container-api: de aquí el bot conoce su tenant (GET /tenant) y obtiene su token de servicio (POST /auth/service-token)
CONTAINER_API_URL=http://localhost:3000
CONTAINER_CLIENT_ID=
CONTAINER_CLIENT_SECRET=
